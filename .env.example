NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Private server-only settings. Never prefix these with NEXT_PUBLIC_.
# Use a hosted PostgreSQL connection string with TLS configured by the provider.
DATABASE_URL=
# Optional provider root certificate when the connection needs a custom CA.
DATABASE_CA_CERT=
# At least 16 characters; use a unique randomly generated password.
PORTAL_ADMIN_PASSWORD=

# Private owner email sign-in (server only)
PORTAL_OWNER_EMAIL=
PORTAL_OWNER_CODE_SECRET=


# Stripe sandbox credentials. Keep these for sandbox records and notifications.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook in the SAME Stripe sandbox.
STRIPE_WEBHOOK_SECRET=

# Production portal defaults to test until explicitly switched to live.
STRIPE_MODE=test
# Separate live credentials; never use a NEXT_PUBLIC_ prefix.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
